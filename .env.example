LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
FALLBACK_PROVIDER=
FALLBACK_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=4096
FETCH_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=3000000
MAX_REDIRECTS=5
MAX_EXTRA_PAGES=2
MAX_CONTENT_CHARS=12000
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=256
LOG_LEVEL=INFO
